{
  "expo": {
    "icon": "./src/assets/images/icon-1024.png",
    "scheme": "acme",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "output": "static"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./src/assets/images/icon-1024.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-router",
        {
          "origin": "https://n"
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "name": "Schooley",
    "slug": "final-year-project",
    "extra": {
      "router": {
        "origin": "https://n"
      },
      "eas": {
        "projectId": "2b69e1cd-c856-4e05-ad75-37abbabc01d0"
      }
    },
    "android": {
      "package": "com.bardsai.schooley"
    },
    "version": "1.0.0",
    "ios": {
      "bundleIdentifier": "com.bardsai.schooley",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "owner": "frankimma"
  }
}
